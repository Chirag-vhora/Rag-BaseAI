# ─────────────────────────────────────────────────────────
# AI HR ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual API keys
# ─────────────────────────────────────────────────────────

# ── 1. PINECONE (Real Vector Database) ──────────────────
# Required for persistent vector storage
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# Your Pinecone index name (must be dimension=768, metric=cosine)
# The live index for this project is called `rag-system`
PINECONE_INDEX=rag-system

# ── 2. GOOGLE GEMINI (LLM + Embeddings) ─────────────────
# Required for real Gemini embeddings + generative answers
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 3. MISTRAL AI (Fallback LLM) ────────────────────────
# Optional — used only if the Gemini LLM call fails
# (the answer then carries a "Reduced AI Mode" note in the UI)
# Get from: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# ── 4. OPENAI (Alternative LLM) ─────────────────────────
# Optional — used if both Gemini and Mistral are absent
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── 5. SERVER PORT ───────────────────────────────────────
PORT=5000
