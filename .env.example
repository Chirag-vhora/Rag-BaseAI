# ─────────────────────────────────────────────────────────
# AI HR ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual API keys
# ─────────────────────────────────────────────────────────

# ── 1. PINECONE (Real Vector Database) ──────────────────
# Required for persistent vector storage
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# Your Pinecone index name (must be set to dimension=768)
PINECONE_INDEX=nexus-hr-index

# ── 2. GOOGLE GEMINI (LLM + Embeddings) ─────────────────
# Required for real Gemini embeddings + generative answers
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 3. MISTRAL AI (Alternative LLM) ─────────────────────
# Optional — used if GEMINI_API_KEY is not present
# Get from: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# ── 4. OPENAI (Alternative LLM) ─────────────────────────
# Optional — used if both Gemini and Mistral are absent
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── 5. SERVER PORT ───────────────────────────────────────
PORT=5000
